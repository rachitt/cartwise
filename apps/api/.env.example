# Postgres connection
DATABASE_URL=postgres://localhost:5432/cartwise

# Kroger Developer API (developer.kroger.com) — client-credentials flow, product.compact scope
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Walmart Affiliate / OPD-style API (walmart.io) — RSA-signed request headers
WALMART_CONSUMER_ID=
# Paste PEM with escaped newlines when storing on one line, e.g. -----BEGIN PRIVATE KEY-----\n...
WALMART_PRIVATE_KEY=
WALMART_KEY_VERSION=1
WALMART_PUBLISHER_ID=
WALMART_DISABLED=0

# Target public web APIs (optional; defaults to target.com's public web key)
TARGET_API_KEY=
TARGET_DISABLED=0

# ALDI storefront/Instacart guest session collector (no credentials required)
ALDI_DISABLED=0

PORT=3000
