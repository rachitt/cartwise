    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@cartwise/shared": "*",
    "@fastify/rate-limit": "^10.0.0",
    "drizzle-orm": "^0.44.0",
    "expo-server-sdk": "^4.0.0",
    "fastify": "^5.0.0",
    "node-cron": "^4.2.1",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  }
}
